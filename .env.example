# Copy these settings to .env and set your API key there.
OPENAI_API_KEY=your_openai_api_key

# Scraper article limit: leave blank for all articles, or set a positive integer.
LIMIT=

ARTICLES_DIR="articles"
INGESTION_LOG_PATH="logs/ingestion.log"
# Required: existing vector store ID. No local state file or automatic store creation.
OPENAI_VECTOR_STORE_ID=""
